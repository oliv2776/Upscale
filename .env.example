# Dossier des vidéos sur l'hôte (chemin absolu) et chemin vu dans l'interface.
UPSCALE_HOST_DATA=/data
UPSCALE_DATA_ROOT=/data
UPSCALE_PORT=27000

# GID réels de /dev/dri/card* (VIDEO_GID) et /dev/dri/renderD* (RENDER_GID).
VIDEO_GID=44
RENDER_GID=109

VIDEO2X_IMAGE=ghcr.io/k4yt3x/video2x:6.4.0
# Index du GPU Vulkan à utiliser (voir « Tester le GPU »). Vide = choix de Video2X.
VIDEO2X_GPU=

DEFAULT_SOURCE=/data/videos
DEFAULT_DESTINATION=/data/videos_upscaled

# Mot de passe de l'interface (authentification HTTP Basic). Généré par install.sh.
# Sans mot de passe, les actions sont refusées : l'interface passe en lecture seule.
UPSCALE_USER=admin
UPSCALE_PASSWORD=
# Autorise les actions sans mot de passe (réseau de confiance uniquement, déconseillé).
UPSCALE_ALLOW_ANONYMOUS=0

# Espace libre minimal conservé sur le disque de destination, en Go.
UPSCALE_MIN_FREE_GB=5

# Noms publics autorisés (reverse proxy, protection CSRF), séparés par des virgules.
# Le proxy doit conserver l'en-tête Host ; X-Forwarded-Host n'est pas utilisé.
UPSCALE_TRUSTED_HOSTS=

# Encodage matériel VAAPI (codecs h264_vaapi / hevc_vaapi).
VAAPI_DEVICE=/dev/dri/renderD128
# Téléchargement de modèles depuis une adresse privée (miroir interne) : désactivé par défaut.
UPSCALE_ALLOW_PRIVATE_MODEL_URLS=0
# Conversion des modèles en « nobody » (setpriv) quand le conteneur est root.
UPSCALE_CONVERTER_DROP_PRIVILEGES=1
# Propriétaire des fichiers produits (id -u / id -g de ton utilisateur).
# Vide = propriétaire de la vidéo d'origine (jamais root).
PUID=
PGID=
# Fuseau horaire utilisé pour la plage horaire de traitement.
TZ=Europe/Paris
# Durée des segments (s) : reprise après coupure et espace disque borné.
UPSCALE_SEGMENT_SECONDS=180
UPSCALE_LOG_RETENTION_DAYS=90
# "always" pour utiliser l'image publiée sur ghcr.io au lieu de la construire (voir README).
UPSCALE_PULL_POLICY=build
UPSCALE_VERSION=latest
