# Dossier des vidéos sur l'hôte (chemin absolu) et chemin vu dans l'interface.
USCALE_HOST_DATA=/data
USCALE_DATA_ROOT=/data
USCALE_PORT=27000

# GID réels de /dev/dri/card* (VIDEO_GID) et /dev/dri/renderD* (RENDER_GID).
VIDEO_GID=44
RENDER_GID=109

VIDEO2X_IMAGE=ghcr.io/k4yt3x/video2x:6.4.0
# Index du GPU Vulkan à utiliser (voir « Tester le GPU »). Vide = choix de Video2X.
VIDEO2X_GPU=

DEFAULT_SOURCE=/data/videos
DEFAULT_DESTINATION=/data/videos_upscaled

# Mot de passe de l'interface (authentification HTTP Basic). Vide = pas d'authentification.
USCALE_USER=admin
USCALE_PASSWORD=

# Espace libre minimal conservé sur le disque de destination, en Go.
USCALE_MIN_FREE_GB=5

# Noms publics supplémentaires autorisés (reverse proxy), séparés par des virgules.
USCALE_TRUSTED_HOSTS=

# Encodage matériel VAAPI (codecs h264_vaapi / hevc_vaapi).
VAAPI_DEVICE=/dev/dri/renderD128
# Propriétaire des fichiers produits (id -u / id -g de ton utilisateur). Vide = root.
PUID=
PGID=
# Fuseau horaire utilisé pour la plage horaire de traitement.
TZ=Europe/Paris
# Durée des segments (s) : reprise après coupure et espace disque borné.
USCALE_SEGMENT_SECONDS=180
USCALE_LOG_RETENTION_DAYS=90
# "always" pour utiliser l'image publiée sur ghcr.io au lieu de la construire (voir README).
USCALE_PULL_POLICY=build
USCALE_VERSION=latest
