# Variante EXPÉRIMENTALE sans socket Docker : Video2X (AppImage officielle) est installé dans l'image
# et lancé directement, avec accès au GPU par /dev/dri. Voir docker-compose.local.yml.
FROM python:3.12-slim

ARG VIDEO2X_VERSION=6.4.0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg ca-certificates curl tini tzdata libvulkan1 mesa-vulkan-drivers mesa-va-drivers libgpg-error0 \
      libgomp1 unzip \
    && rm -rf /var/lib/apt/lists/*
# Moteur des modèles personnalisés : realesrgan-ncnn-vulkan (Vulkan, compatible AMD).
ARG NCNN_URL=https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesrgan-ncnn-vulkan-20220424-ubuntu.zip
RUN curl -fsSL -o /tmp/ncnn.zip "${NCNN_URL}" \
    && mkdir -p /opt/realesrgan && unzip -q /tmp/ncnn.zip -d /opt/realesrgan && rm /tmp/ncnn.zip \
    && bin="$(find /opt/realesrgan -type f -name realesrgan-ncnn-vulkan | head -n 1)" && test -n "${bin}" \
    && chmod +x "${bin}" \
    && { [ "${bin}" = /opt/realesrgan/realesrgan-ncnn-vulkan ] || ln -sf "${bin}" /opt/realesrgan/realesrgan-ncnn-vulkan; }

# L'AppImage est extraite à la construction : pas besoin de FUSE à l'exécution.
RUN curl -fsSL -o /tmp/video2x.AppImage \
      "https://github.com/k4yt3x/video2x/releases/download/${VIDEO2X_VERSION}/Video2X-x86_64.AppImage" \
    && chmod +x /tmp/video2x.AppImage \
    && cd /opt && /tmp/video2x.AppImage --appimage-extract > /dev/null \
    && mv /opt/squashfs-root /opt/video2x && rm /tmp/video2x.AppImage \
    # Video2X cherche « models/... » relativement au dossier courant : on expose le dossier des modèles.
    && models="$(find /opt/video2x -type d -name models -path '*video2x*' | head -n 1)" \
    && test -n "${models}" && echo "Modèles Video2X : ${models}" \
    && mkdir -p /usr/share/video2x && ln -s "${models}" /usr/share/video2x/models

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY VERSION app.py ./
COPY upscale ./upscale
COPY static ./static
RUN mkdir -p /app/state
ENV UPSCALE_RUNNER=local VIDEO2X_BIN=/opt/video2x/AppRun VIDEO2X_WORKDIR=/usr/share/video2x \
    VIDEO2X_IMAGE="video2x ${VIDEO2X_VERSION} (AppImage)"
EXPOSE 27000
HEALTHCHECK --interval=60s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:27000/api/ping', timeout=4)"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "app.py"]
